# Copy to .env and fill in. Never commit .env.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used to upload images/prescriptions and to import users.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Database (Supabase -> Connect -> ORMs -> Prisma) ---
# App runtime: transaction pooler (port 6543). Best for Vercel serverless.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Migrations: session/direct connection (port 5432).
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- Paystack (Settings -> API Keys & Webhooks) ---
# Server only. The public key is not needed; checkout uses Paystack's hosted page.
PAYSTACK_SECRET_KEY=sk_test_...

# --- Delivery fee (optional) ---
# Server key with Geocoding API and Routes API enabled. Without it, DELIVERY_FLAT_FEE_NAIRA is charged.
GOOGLE_MAPS_API_KEY=
DELIVERY_FLAT_FEE_NAIRA=2000
# Where orders are dispatched from (defaults to the old site's origin).
STORE_LAT=6.504502
STORE_LNG=3.37762

# --- Pharmacist chat assistant (optional) ---
# Server only (console.anthropic.com -> API Keys). Without it, every chat goes straight to a pharmacist.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 (Claude Opus 5.5).
ANTHROPIC_MODEL=

# --- Firebase migration only (scripts/migrate-from-firebase.ts) ---
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
